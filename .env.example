# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不要提交真实密钥
APP_PORT=8080
SPRING_PROFILES_ACTIVE=mysql
# 生产环境必须替换为至少 32 字节的随机字符串；留空时应用会生成临时密钥（重启后令牌失效）
JWT_SECRET=
DEMO_SEED_ENABLED=true

# MySQL（compose 默认数据库；SPRING_PROFILES_ACTIVE=mysql 时生效）
MYSQL_ROOT_PASSWORD=ctf-root
MYSQL_DATABASE=ctf
MYSQL_USER=ctf
MYSQL_PASSWORD=ctf
# 自定义连接串时覆盖（默认指向 compose 内的 mysql 服务）
# DB_URL=jdbc:mysql://127.0.0.1:3306/ctf?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false

# Redis：JWT 吊销黑名单。compose 全家桶默认开启；h2 轻量模式请设 REDIS_ENABLED=false
REDIS_ENABLED=true

# MongoDB：审计日志镜像到 op_logs 集合。h2 轻量模式请设 MONGO_ENABLED=false
MONGO_ENABLED=true
# MONGO_URI=mongodb://127.0.0.1:27017/ctf

# 服务器部署（deploy/docker-compose.server.yml）必填：镜像地址
# APP_IMAGE=ghcr.io/kkk287/ctf-platform:latest

# 可选：PostgreSQL（SPRING_PROFILES_ACTIVE=postgres，本地直跑时使用）
# DB_URL=jdbc:postgresql://127.0.0.1:5432/ctf
# DB_USERNAME=ctf
# DB_PASSWORD=
